<Window x:Class="SimpleModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Mod Manager"
        Height="650" Width="950"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        FontFamily="pack://application:,,,/Fonts/#Fira Code">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#D60F1717"/>
        <SolidColorBrush x:Key="PanelBg" Color="Transparent"/>
        <SolidColorBrush x:Key="CardBg" Color="#EA162035"/>
        <SolidColorBrush x:Key="CardBgHover" Color="#F2212E4A"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8191AD"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#C7245D"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#D93C72"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#28354D"/>

        <Style x:Key="WindowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardBgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardBgHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" Padding="15,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Background="{StaticResource BorderBrush}" Height="6" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource AccentPrimary}" BorderThickness="0" Focusable="False" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="6" CornerRadius="3,0,0,3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentPrimary}" Width="16" Height="16"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanScrollThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" CornerRadius="3" Background="{StaticResource BorderBrush}" Width="6" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderBrush="Transparent" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CleanScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderBrush="Transparent" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBorder}" ClipToBounds="True">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" CornerRadius="15,15,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Border BorderThickness="1" BorderBrush="{StaticResource AccentPrimary}" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="ActivePlatformLabel" Text="UNCONFIGURED" Foreground="{StaticResource AccentPrimary}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="12" Padding="15" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,10,0,0">
                            <RadioButton x:Name="ModsNavBtn" Content="Mods List" IsChecked="True" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="FindModsNavBtn" Content="Find Mods" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="SyncModsNavBtn" Content="Sync Mods" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="CleanerNavBtn" Content="Pak Cleaner" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="ContactNavBtn" Content="Contact" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="AboutNavBtn" Content="About" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                            <RadioButton x:Name="SettingsNavBtn" Content="Settings" Style="{StaticResource NavTabStyle}" Checked="NavBtn_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button Content="Fix Pakbypass" Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,0,8" Click="FixPakbypass_Click" FontSize="11"/>
                            <Button Content="Open Mods Folder" Style="{StaticResource SecondaryButton}" Padding="10,8" Click="OpenModsFolder_Click" FontSize="11"/>
                            <Button Content="Change Platform" Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,8,0,0" Click="ChangePlatform_Click" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="20,0,0,0">

                    <Grid x:Name="ModsPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="GameRunningBanner" Grid.Row="0" Visibility="Collapsed"
                                Background="#1F1A0900" BorderThickness="1" BorderBrush="#4D3800"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Fill="#FFB400" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Dead by Daylight is running — restart the game after applying changes."
                                           Foreground="#FFB400" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,0,0,15">
                            <Button Style="{StaticResource FlatButton}" Width="36" Height="36" DockPanel.Dock="Right" Click="RefreshMods_Click" ToolTip="Refresh Mods">
                                <Path Data="M13.5,6.5 C10.8,3.8 6.6,3.8 3.9,6.5 C1.2,9.2 1.2,13.4 3.9,16.1 C6.6,18.8 10.8,18.8 13.5,16.1 C15.4,14.2 16.1,11.6 15.6,9.1 M16.5,4.5 L16.5,9.5 L11.5,9.5"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" DockPanel.Dock="Right"
                                    Click="TurnOffAll_Click" ToolTip="Disable all active mods"
                                    Padding="14,0" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold">
                                Turn Off All
                            </Button>
                            <Button x:Name="CloseGameBtn" Style="{StaticResource SecondaryButton}" Height="36" DockPanel.Dock="Right"
                                    Click="CloseGame_Click" ToolTip="Close the game"
                                    Padding="14,0" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                                    Visibility="Collapsed">
                                Close Game
                            </Button>
                            <TextBlock Text="Available Mods" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ModsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="205" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="{StaticResource CardBg}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Width="185" Height="140" Margin="0,0,15,15" SnapsToDevicePixels="True" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Ellipse Fill="{Binding StatusIndicatorBrush}" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ActivationText}" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PakName}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PakName}"/>
                                                </StackPanel>

                                                <Grid Grid.Row="1">
                                                    <Button Content="TURN ON" Style="{StaticResource FlatButton}" Padding="10,6" Click="ToggleModStatus_Click" Visibility="{Binding InactiveVisibility}"/>
                                                    <Button Content="TURN OFF" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="ToggleModStatus_Click" Visibility="{Binding ActiveVisibility}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="CleanerPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                            <TextBlock Text="Pak Folder Cleaner" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="If your game is crashing or you want to play without mods, use the cleaner to restore your pak folder to vanilla. This will remove all active mods."
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="18"/>

                            <Border CornerRadius="8" Background="#24171E" BorderThickness="1" BorderBrush="#471C2E" Padding="15" Margin="0,0,0,25">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Warning:" Foreground="#FF4D4D" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="This process is permanent." Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="RESTORE PAK FOLDER" Style="{StaticResource FlatButton}" Background="#E63946" Foreground="White" Padding="25,15" FontSize="14" Click="PurgeMods_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                            <TextBlock Text="Settings" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="Configure application behavior and appearance."
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,35" LineHeight="18"/>

                            <Border CornerRadius="12" Background="{StaticResource CardBg}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="WINDOW TRANSPARENCY" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0" Maximum="100" Value="60" Style="{StaticResource FlatSliderStyle}" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="60%" Foreground="White" FontSize="13" FontWeight="Bold" Margin="15,0,0,0" Width="45" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ContactPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">

                            <Border Width="72" Height="72" CornerRadius="18" Background="#5865F2" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Path Fill="White"
                                      Data="M 0,1 C 0,0.45 0.45,0 1,0 H 13 C 13.55,0 14,0.45 14,1 V 8 C 14,8.55 13.55,9 13,9 H 8 L 5.5,12 V 9 H 1 C 0.45,9 0,8.55 0,8 Z"
                                      Width="28" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Join Our Discord" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Get support, share feedback, and connect with the Isolumia community."
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>

                            <Button Content="discord.gg/isolumia" Style="{StaticResource FlatButton}"
                                    Background="#5865F2" Foreground="White"
                                    Padding="25,14" FontSize="13"
                                    Click="OpenDiscord_Click"/>

                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AboutPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Path Fill="White" Data="M 7,0 H 9 V 8 H 12 L 8,13 L 4,8 H 7 Z" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Simple Mod Manager" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="simple mod manager for dead by daylight" Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FindModsPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">

                            <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource AccentPrimary}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Path Stroke="White" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7,1 L 13,1 L 13,7 M 13,1 L 5,9 M 4,5 H 1 C 0.45,5 0,5.45 0,6 V 13 C 0,13.55 0.45,14 1,14 H 8 C 8.55,14 9,13.55 9,13 V 10"
                                      Width="26" Height="26" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Isolumia Mod Hub" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Browse and download community mods for Dead by Daylight at the official Isolumia Mod Hub."
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>

                            <Button Content="Open Mod Hub" Style="{StaticResource FlatButton}"
                                    Padding="25,14" FontSize="13"
                                    Click="OpenModHub_Click"/>

                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SyncModsPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                            <TextBlock Text="Sync Mods" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Sync your selected mods directly from your Isolumia Mod Hub downloads to the Mod Manager."
                                       Foreground="{StaticResource TextMuted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>

                            <Border CornerRadius="12" Background="{StaticResource CardBg}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="LICENSE KEY" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="LicenseKeyTextBox" Background="#0A0F1A" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="36" Padding="10,6" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,0,15"/>

                                    <Button x:Name="SyncModsBtn" Content="SYNC NOW" Style="{StaticResource FlatButton}" Padding="25,12" FontSize="13" Click="SyncMods_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="SyncStatusLabel" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>

            <Border x:Name="DragOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                    Background="#E00F1717" CornerRadius="16" Panel.ZIndex="5" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{StaticResource AccentPrimary}" HorizontalAlignment="Center">
                        <Path Fill="White"
                              Data="M 7,0 H 9 V 8 H 12 L 8,13 L 4,8 H 7 Z"
                              Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drop to Install" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Supports .zip files and mod folders" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid x:Name="OverlayPanel" Grid.RowSpan="2" Background="#CC060E0E" Visibility="Collapsed">
                <Border CornerRadius="16" Background="#FF131E1E" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Select Game Platform" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Please choose your Dead by Daylight installation platform:" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SteamSelectBtn" Grid.Column="0" Content="STEAM" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,20" Click="PlatformSelect_Click"/>
                            <Button x:Name="EpicSelectBtn" Grid.Column="1" Content="EPIC GAMES" Style="{StaticResource SecondaryButton}" Margin="6,0,6,0" Padding="10,20" Click="PlatformSelect_Click"/>
                            <Button x:Name="MicrosoftSelectBtn" Grid.Column="2" Content="MICROSOFT" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,20" Click="PlatformSelect_Click"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,5,0,15"/>

                        <TextBlock Text="Game Pak Folder Location" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button Content="Browse" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Padding="12,6" Margin="10,0,0,0" Click="BrowseDbdPath_Click"/>
                            <TextBox x:Name="DbdPathTextBox" Background="#0A0F1A" Foreground="White" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="11" IsReadOnly="True"/>
                        </DockPanel>

                        <TextBlock x:Name="DetectionStatusLabel" Text="Waiting for selection..." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,8,0,0"/>

                        <Button x:Name="ConfirmPlatformBtn" Content="CONTINUE" Style="{StaticResource FlatButton}" Padding="20,12" Margin="0,25,0,0" IsEnabled="False" Click="ConfirmPlatform_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
